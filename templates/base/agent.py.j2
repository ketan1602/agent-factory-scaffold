from __future__ import annotations

from langgraph.graph import END, StateGraph

from harness_core import AgentHarness, get_logger, load_config

from .nodes import analyze
from .schemas import {{ agent_class_name }}Input, {{ agent_class_name }}Output

logger = get_logger(__name__)


def _build_graph():
    g = StateGraph(dict)
    g.add_node("analyze", analyze)
    g.set_entry_point("analyze")
    g.add_edge("analyze", END)
    return g.compile()


_graph = _build_graph()
_config = load_config("config/harness.yaml")

harness = AgentHarness(
    graph=_graph,
    agent_name="{{ agent_name }}",
    agent_version="0.1.0",
    input_schema={{ agent_class_name }}Input,
    output_schema={{ agent_class_name }}Output,
    config=_config,
)
